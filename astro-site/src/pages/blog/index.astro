---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const postsRaw = await getCollection('blogPosts');
const posts = postsRaw.sort((a, b) => b.data.datePublished.getTime() - a.data.datePublished.getTime());

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'CollectionPage',
        '@id': 'https://openratelab.com/blog/#webpage',
        url: 'https://openratelab.com/blog/',
        name: 'Email Marketing Blog | Klaviyo Tips for DTC Brands | OpenRateLab',
        description: 'Email marketing tactics, Klaviyo guides, and benchmarks from an agency that manages active DTC accounts.',
        isPartOf: { '@type': 'WebSite', url: 'https://openratelab.com/', name: 'OpenRateLab' },
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://openratelab.com/' },
          { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://openratelab.com/blog/' },
        ],
      },
      {
        '@type': 'ItemList',
        itemListElement: posts.map((post, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          url: `https://openratelab.com/blog/${post.id}`,
          name: post.data.title.split('|')[0].trim(),
        })),
      },
    ],
  },
];

const dateStr = (d: Date) => d.toISOString().slice(0, 10);
---

<BaseLayout
  title="Email Marketing Blog | Klaviyo Tips for DTC Brands | OpenRateLab"
  description="Email marketing tactics, Klaviyo guides, and benchmarks from an agency that manages active DTC accounts. No theory. Data sourced from active accounts."
  canonicalPath="/blog/"
  jsonLd={jsonLd}
  activeNav="blog"
>
  <section class="px-8 md:px-16 py-24 md:py-32">
    <span class="font-label-technical text-label-technical text-accent-performance uppercase mb-4 block">[ KLAVIYO KNOWLEDGE ]</span>
    <h1 class="font-display-xl-mobile text-headline-lg-mobile md:text-headline-lg font-black uppercase mb-4 leading-none">EMAIL MARKETING BLOG</h1>
    <p class="font-body-lg text-body-lg text-muted-silver max-w-2xl">Klaviyo guides, benchmarks, and flow deep-dives, from an agency that manages active DTC accounts, not theory.</p>
  </section>

  <section class="px-8 md:px-16 pb-24">
    <div class="space-y-0">
      {posts.map((post) => (
        <a href={`/blog/${post.id}`} class="article-card block group border-b border-muted-silver/20 py-12 grid grid-cols-12 gap-8 items-start hover:bg-surface-secondary/30 -mx-8 px-8 md:-mx-16 md:px-16 transition-colors">
          <div class="col-span-12 md:col-span-2">
            <span class="font-label-technical text-label-technical text-muted-silver"><time datetime={dateStr(post.data.datePublished)}>{dateStr(post.data.datePublished)}</time></span>
            <div class="mt-2 font-label-technical text-label-technical text-muted-silver/50">{post.data.readTime}</div>
          </div>
          <div class="col-span-12 md:col-span-7">
            <span class="font-label-technical text-label-technical text-accent-performance uppercase mb-4 block">{post.data.category}</span>
            <h2 class="card-title font-headline-md text-headline-md text-on-surface-warm mb-4 transition-colors">{post.data.title.split('|')[0].trim()}</h2>
            <p class="font-body-md text-body-md text-muted-silver">{post.data.excerpt}</p>
          </div>
          <div class="col-span-12 md:col-span-3 flex md:justify-end items-start pt-1">
            <span class="card-arrow font-label-button text-muted-silver uppercase group-hover:text-accent-performance transition-colors">READ &rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 md:py-32 px-8 md:px-16 text-center pixel-grid border-t border-muted-silver/20">
    <span class="font-label-technical text-label-technical text-accent-performance uppercase mb-6 block">DEPLOYMENT_FINAL_PHASE</span>
    <h2 class="font-display-xl-mobile text-headline-lg-mobile md:text-headline-lg uppercase mb-8 leading-tight">WANT RESULTS<br/>LIKE THIS?</h2>
    <p class="font-body-lg text-body-lg text-muted-silver mb-12 max-w-2xl mx-auto italic">Tell us where you are, what's not working, and what you want to grow. We'll map out an exact strategy. No cost, no obligation.</p>
    <a href="/#contact" class="inline-block bg-on-surface-warm text-surface-primary px-10 md:px-16 py-6 md:py-8 font-label-button uppercase text-lg md:text-2xl tracking-[0.2em] hover:bg-accent-performance hover:text-on-surface-warm transition-all duration-300">
      GET A FREE AUDIT
    </a>
  </section>
</BaseLayout>

<style>
  .article-card:hover .card-title {
    color: #E63946;
  }
</style>

---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blogPosts');
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
const canonicalPath = `/blog/${entry.id}`;
const canonicalUrl = `https://openratelab.com${canonicalPath}`;
const dateISO = (d: Date) => d.toISOString();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Article',
        headline: data.title,
        description: data.description,
        url: canonicalUrl,
        image: `https://openratelab.com${data.ogImage}`,
        datePublished: dateISO(data.datePublished),
        dateModified: dateISO(data.dateModified),
        author: { '@type': 'Person', name: data.author, url: 'https://openratelab.com/about/' },
        publisher: {
          '@type': 'Organization',
          name: 'OpenRateLab',
          url: 'https://openratelab.com',
          logo: { '@type': 'ImageObject', url: `https://openratelab.com${data.ogImage}` },
        },
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://openratelab.com/' },
          { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://openratelab.com/blog/' },
          { '@type': 'ListItem', position: 3, name: data.title.split('|')[0].trim(), item: canonicalUrl },
        ],
      },
    ],
  },
  ...(data.faq.length > 0
    ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: data.faq.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: { '@type': 'Answer', text: item.answer },
        })),
      }]
    : []),
];
---

<BaseLayout
  title={data.title}
  description={data.description}
  canonicalPath={canonicalPath}
  ogImage={data.ogImage}
  ogImageWidth={data.ogImageWidth}
  ogImageHeight={data.ogImageHeight}
  ogType="article"
  jsonLd={jsonLd}
  activeNav="blog"
>
  <article class="px-8 md:px-16 py-20 max-w-3xl mx-auto">
    <a href="/blog/" class="inline-flex items-center gap-2 font-label-technical text-label-technical text-muted-silver uppercase hover:text-accent-performance transition-colors mb-10 w-fit">
      <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_back</span> BACK TO THE BLOG
    </a>
    <div class="mb-12">
      <span class="font-label-technical text-label-technical text-muted-silver uppercase">{data.author} &middot; {data.readTime}</span>
    </div>
    <div class="prose-article">
      <Content />
    </div>
  </article>

  {data.dataDisclaimer && (
    <>
      <div class="px-8 md:px-16 max-w-3xl mx-auto"><div class="rule-line opacity-50"></div></div>
      <section class="px-8 md:px-16 py-16 max-w-3xl mx-auto">
        <p class="font-label-technical text-label-technical text-muted-silver">[ DATA_NOTE ] {data.dataDisclaimer}</p>
      </section>
    </>
  )}

  {data.faq.length > 0 && <FaqAccordion items={data.faq} />}

  <!-- CTA -->
  <section class="py-24 md:py-32 px-8 md:px-16 text-center pixel-grid border-t border-muted-silver/20">
    <span class="font-label-technical text-label-technical text-accent-performance uppercase mb-6 block">DEPLOYMENT_FINAL_PHASE</span>
    <h2 class="font-display-xl-mobile text-headline-lg-mobile md:text-headline-lg uppercase mb-8 leading-tight">WANT RESULTS<br/>LIKE THIS?</h2>
    <p class="font-body-lg text-body-lg text-muted-silver mb-12 max-w-2xl mx-auto italic">Tell us where you are, what's not working, and what you want to grow. We'll map out an exact strategy. No cost, no obligation.</p>
    <a href="/#contact" class="inline-block bg-on-surface-warm text-surface-primary px-10 md:px-16 py-6 md:py-8 font-label-button uppercase text-lg md:text-2xl tracking-[0.2em] hover:bg-accent-performance hover:text-on-surface-warm transition-all duration-300">
      GET A FREE AUDIT
    </a>
  </section>
</BaseLayout>

<style>
  .prose-article :global(h2) {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 28px;
    line-height: 36px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: #F9F9F7;
    margin-top: 56px;
    margin-bottom: 20px;
  }
  .prose-article :global(h3) {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 18px;
    line-height: 26px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: #F9F9F7;
    margin-top: 36px;
    margin-bottom: 12px;
  }
  .prose-article :global(p) {
    font-family: 'Source Serif 4', serif;
    font-size: 18px;
    line-height: 30px;
    color: #c8c5c2;
    margin-bottom: 24px;
  }
  .prose-article :global(strong) {
    color: #F9F9F7;
    font-weight: 700;
  }
  .prose-article :global(ul) {
    margin-bottom: 24px;
    padding-left: 0;
    list-style: none;
  }
  .prose-article :global(ul li) {
    font-family: 'Source Serif 4', serif;
    font-size: 18px;
    line-height: 30px;
    color: #c8c5c2;
    padding-left: 20px;
    position: relative;
    margin-bottom: 8px;
  }
  .prose-article :global(ul li::before) {
    content: "—";
    position: absolute;
    left: 0;
    color: #E63946;
  }
  .prose-article :global(a) {
    color: #E63946;
    text-decoration: underline;
  }
  .prose-article :global(.benchmark-table),
  .prose-article :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 36px 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    color: #c8c5c2;
  }
  .prose-article :global(table th),
  .prose-article :global(table td) {
    border: 1px solid rgba(163, 163, 163, 0.2);
    padding: 10px 14px;
    text-align: left;
  }
  .prose-article :global(.stat-callout) {
    background: #1a1a1a;
    border-left: 3px solid #E63946;
    padding: 24px 28px;
    margin: 36px 0;
  }
  .prose-article :global(.stat-callout .stat-num) {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 48px;
    line-height: 52px;
    font-weight: 800;
    color: #F9F9F7;
  }
  .prose-article :global(.stat-callout .stat-label) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #A3A3A3;
    margin-top: 4px;
  }
  .prose-article :global(.finding-block),
  .prose-article :global(.example-block),
  .prose-article :global(.segment-tier) {
    background: #1a1a1a;
    border: 1px solid rgba(163, 163, 163, 0.2);
    padding: 20px 24px;
    margin: 28px 0;
  }
</style>

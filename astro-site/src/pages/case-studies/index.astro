---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const caseStudies = (await getCollection('caseStudies')).sort((a, b) =>
  b.data.caseStudyNumber.localeCompare(a.data.caseStudyNumber)
);

function truncate(text: string, max = 150) {
  if (text.length <= max) return text;
  const clipped = text.slice(0, max);
  const lastSpace = clipped.lastIndexOf(' ');
  return (lastSpace > 0 ? clipped.slice(0, lastSpace) : clipped) + '…';
}

const canonicalPath = '/case-studies/';
const canonicalUrl = `https://openratelab.com${canonicalPath}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'CollectionPage',
        name: 'Case Studies | OpenRateLab',
        description: 'Every Klaviyo email marketing case study: real results, real numbers, across ecommerce and DTC brands.',
        url: canonicalUrl,
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://openratelab.com/' },
          { '@type': 'ListItem', position: 2, name: 'Case Studies', item: canonicalUrl },
        ],
      },
      {
        '@type': 'ItemList',
        itemListElement: caseStudies.map((cs, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: cs.data.title.split('|')[0].trim(),
          url: `https://openratelab.com/case-studies/${cs.id}`,
        })),
      },
    ],
  },
];
---

<BaseLayout
  title="Case Studies | OpenRateLab"
  description="Every Klaviyo email marketing case study we've published: real results, real numbers, across ecommerce and DTC brands."
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
  activeNav="case-studies"
>
  <!-- Hero -->
  <section class="min-h-[45vh] flex flex-col justify-center px-8 md:px-16 py-20 relative overflow-hidden pixel-grid">
    <span class="font-label-technical text-label-technical text-accent-performance uppercase mb-8 block">[ THE LEDGER // ALL DEPLOYMENTS ]</span>
    <h1 class="font-display-xl text-display-lg-mobile md:text-display-xl uppercase leading-none tracking-tighter mb-8 max-w-4xl">
      EVERY RESULT.<br/>NO CHERRY-PICKING.
    </h1>
    <p class="font-body-lg text-body-lg text-muted-silver max-w-2xl border-l-2 border-accent-performance pl-8 italic">
      {caseStudies.length} case studies, real metrics on every one. Composite studies are labeled as composite; real client data is labeled as real. Newest first.
    </p>
  </section>

  <!-- Grid -->
  <section class="px-8 md:px-16 py-16 md:py-24 border-t border-muted-silver/20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {caseStudies.map((entry) => (
        <div class="p-8 border border-muted-silver/20 hover:bg-white/5 transition-colors flex flex-col justify-between min-h-[380px]">
          <div>
            <span class="font-label-technical text-label-technical text-accent-performance mb-4 block">
              [ CASE_STUDY:{entry.data.caseStudyNumber} // {entry.data.industryLabel.toUpperCase()} ]
            </span>
            <span class="font-label-technical text-label-technical text-muted-silver uppercase block mb-6">
              {entry.data.isComposite ? 'COMPOSITE CASE STUDY' : 'REAL CLIENT DATA'}
            </span>
            <div class="font-display-xl-mobile text-display-xl-mobile font-black text-accent-performance leading-none mb-2">{entry.data.primaryMetric.value}</div>
            <span class="font-label-button uppercase text-muted-silver block mb-6">{entry.data.primaryMetric.label}</span>
            <p class="font-body-md text-body-md text-muted-silver mb-8">{truncate(entry.data.heroSubtext)}</p>
          </div>
          <a href={`/case-studies/${entry.id}`} class="w-full py-4 border border-on-surface-warm text-on-surface-warm font-label-button uppercase hover:bg-on-surface-warm hover:text-surface-primary transition-all text-center">READ FULL CASE STUDY</a>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 md:py-32 px-8 md:px-16 text-center pixel-grid">
    <span class="font-label-technical text-label-technical text-accent-performance uppercase mb-6 block">SYSTEM_CHECK</span>
    <h2 class="font-display-xl-mobile text-headline-lg-mobile md:text-headline-lg uppercase mb-8 leading-tight">WANT RESULTS<br/>LIKE THESE?</h2>
    <p class="font-body-lg text-body-lg text-muted-silver mb-12 max-w-2xl mx-auto italic">Free audit, no obligation. We'll map out an exact strategy for your account.</p>
    <a href="/#contact" class="inline-block bg-on-surface-warm text-surface-primary px-10 md:px-16 py-6 md:py-8 font-label-button uppercase text-lg md:text-2xl tracking-[0.2em] hover:bg-accent-performance hover:text-on-surface-warm transition-all duration-300">
      GET A FREE AUDIT
    </a>
  </section>
</BaseLayout>

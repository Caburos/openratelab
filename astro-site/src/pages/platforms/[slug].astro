---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';

export async function getStaticPaths() {
  const platforms = await getCollection('platforms');
  return platforms.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
const canonicalPath = `/platforms/${entry.id}`;
const canonicalUrl = `https://openratelab.com${canonicalPath}`;
const cleanTitle = data.title.split('|')[0].trim();

const relatedServices = (
  await Promise.all(data.relatedServices.map((id) => getEntry('services', id)))
).filter((s): s is NonNullable<typeof s> => Boolean(s));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: cleanTitle,
        description: data.description,
        url: canonicalUrl,
        serviceType: 'Email Marketing Management',
        provider: {
          '@type': 'Organization',
          name: 'OpenRateLab',
          url: 'https://openratelab.com',
          logo: { '@type': 'ImageObject', url: 'https://openratelab.com/images/logo.png' },
        },
        areaServed: 'Worldwide',
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://openratelab.com/' },
          { '@type': 'ListItem', position: 2, name: 'Platforms', item: 'https://openratelab.com/platforms/' },
          { '@type': 'ListItem', position: 3, name: data.platformLabel, item: canonicalUrl },
        ],
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: data.faq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
];
---

<BaseLayout
  title={data.title}
  description={data.description}
  canonicalPath={canonicalPath}
  ogImage={data.ogImage}
  ogImageWidth={data.ogImageWidth}
  ogImageHeight={data.ogImageHeight}
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="min-h-[50vh] flex flex-col justify-center px-8 md:px-16 py-20 relative overflow-hidden pixel-grid">
    <a href="/platforms/" class="inline-flex items-center gap-2 font-label-technical text-label-technical text-muted-silver uppercase hover:text-accent-performance transition-colors mb-10 w-fit">
      <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_back</span> ALL PLATFORMS
    </a>
    <span class="font-label-technical text-label-technical text-accent-performance uppercase block mb-4 tracking-[0.2em]">
      [ PLATFORM // {data.eyebrow} ]
    </span>
    <h1 class="font-display-xl-mobile text-headline-lg-mobile md:text-headline-lg font-black md:font-bold uppercase leading-none mb-6 max-w-3xl" set:html={data.heroHeadline.replace(/\n/g, '<br/>')} />
    <p class="font-body-lg text-body-lg text-muted-silver max-w-2xl">{data.heroSubtext}</p>
  </section>

  <!-- Body content, rendered from MDX -->
  <section class="py-24 md:py-40 px-8 md:px-16 bg-surface-primary border-t border-muted-silver/20">
    <div class="prose-service max-w-4xl">
      <Content />
    </div>
  </section>

  <!-- CTA banner -->
  <section class="py-24 md:py-32 px-8 md:px-16 text-center pixel-grid border-t border-muted-silver/20">
    <span class="font-label-technical text-label-technical text-accent-performance uppercase mb-6 block">SYSTEM_CHECK</span>
    <h2 class="font-display-xl-mobile text-headline-lg-mobile md:text-headline-lg uppercase mb-8 leading-tight">SEE WHAT'S UNDERUSED<br/>IN YOUR ACCOUNT.</h2>
    <p class="font-body-lg text-body-lg text-muted-silver mb-12 max-w-2xl mx-auto italic">Free audit, no obligation. A specific, written breakdown of what's underperforming, whether or not you ever work with us.</p>
    <a href="/#contact" class="inline-block bg-on-surface-warm text-surface-primary px-10 md:px-16 py-6 font-label-button uppercase text-lg tracking-[0.2em] hover:bg-accent-performance hover:text-on-surface-warm transition-all duration-300">
      GET A FREE AUDIT
    </a>
  </section>

  <FaqAccordion items={data.faq} />

  <section class="px-8 md:px-16 py-16 border-t border-muted-silver/20">
    <span class="font-label-technical text-label-technical text-accent-performance uppercase block mb-6">RELATED READING</span>
    <ul class="space-y-3">
      {data.comparePageUrl && (
        <li><a href={data.comparePageUrl} class="font-label-button uppercase text-muted-silver hover:text-accent-performance transition-colors">&rarr; Klaviyo vs {data.platformLabel}</a></li>
      )}
      {relatedServices.map((svc) => (
        <li><a href={`/services/${svc.id}`} class="font-label-button uppercase text-muted-silver hover:text-accent-performance transition-colors">&rarr; {svc.data.title.split('|')[0].trim()}</a></li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .prose-service :global(h2) {
    font-family: 'Hanken Grotesk', sans-serif;
    text-transform: uppercase;
    font-weight: 700;
    font-size: 32px;
    line-height: 40px;
    color: #F9F9F7;
    margin-top: 56px;
    margin-bottom: 20px;
  }
  .prose-service :global(p) {
    font-family: 'Source Serif 4', serif;
    font-size: 20px;
    line-height: 32px;
    color: #F9F9F7;
    margin-bottom: 24px;
  }
  .prose-service :global(ul), .prose-service :global(ol) {
    margin-bottom: 24px;
    padding-left: 1.5em;
  }
  .prose-service :global(li) {
    font-family: 'Source Serif 4', serif;
    font-size: 18px;
    line-height: 28px;
    color: #F9F9F7;
    margin-bottom: 8px;
  }
  .prose-service :global(strong) {
    color: #F9F9F7;
    font-weight: 700;
  }
</style>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const services = (await getCollection('services')).sort((a, b) =>
  a.data.serviceNumber.localeCompare(b.data.serviceNumber)
);

const canonicalPath = '/services/';
const canonicalUrl = `https://openratelab.com${canonicalPath}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'CollectionPage',
        name: 'Klaviyo Email Marketing Services | OpenRateLab',
        description: 'Klaviyo management, email copywriting, flows and automation, audits, deliverability, segmentation, strategy, setup, and migration for ecommerce and DTC brands.',
        url: canonicalUrl,
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://openratelab.com/' },
          { '@type': 'ListItem', position: 2, name: 'Services', item: canonicalUrl },
        ],
      },
      {
        '@type': 'ItemList',
        itemListElement: services.map((s, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: s.data.title.split('|')[0].trim(),
          url: `https://openratelab.com/services/${s.id}`,
        })),
      },
    ],
  },
];
---

<BaseLayout
  title="Klaviyo Email Marketing Services | OpenRateLab"
  description="Klaviyo management, flows and automation, email copywriting, audits, deliverability, segmentation, strategy, setup, and migration for ecommerce and DTC brands."
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
  activeNav="services"
>
  <!-- Hero -->
  <section class="min-h-[50vh] flex flex-col justify-center px-8 md:px-16 py-20 relative overflow-hidden pixel-grid">
    <span class="font-label-technical text-label-technical text-accent-performance uppercase mb-8 block">[ WHAT WE DO ]</span>
    <h1 class="font-display-xl text-display-lg-mobile md:text-display-xl uppercase leading-none tracking-tighter mb-8 max-w-4xl">
      EVERY SERVICE. ONE<br/>RETENTION SYSTEM.
    </h1>
    <p class="font-body-lg text-body-lg text-muted-silver max-w-2xl border-l-2 border-accent-performance pl-8 italic">
      Ten specialized services, all built around the same goal: a Klaviyo account that compounds revenue every month instead of resetting. Pick the one that matches where you are, or book a free audit and we'll tell you which one you actually need.
    </p>
  </section>

  <!-- Services grid -->
  <section class="px-8 md:px-16 py-16 md:py-24 border-t border-muted-silver/20">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-0 border border-muted-silver/20">
      {services.map((service, i) => (
        <a
          href={`/services/${service.id}`}
          class:list={[
            'p-10 border-muted-silver/20 hover:bg-white/5 transition-colors group',
            i % 2 === 0 ? 'md:border-r' : '',
            i < services.length - (services.length % 2 === 0 ? 2 : 1) ? 'border-b' : '',
          ]}
        >
          <span class="font-label-technical text-label-technical text-accent-performance mb-6 block">{service.data.serviceNumber} / {service.data.eyebrow.replace(/_/g, ' ')}</span>
          <h2 class="font-headline-md text-headline-md uppercase mb-6 leading-tight">{service.data.title.split('|')[0].trim()}</h2>
          <p class="font-body-md text-body-md text-muted-silver mb-8">{service.data.summary}</p>
          <div class="flex items-center justify-between">
            <span class="font-label-technical text-label-technical text-muted-silver uppercase">{service.data.primaryMetric.value} {service.data.primaryMetric.label}</span>
            <span class="flex items-center text-accent-performance font-label-technical group-hover:translate-x-2 transition-transform">
              <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Process, linked from homepage -->
  <section class="py-24 md:py-40 px-8 md:px-16 bg-surface-secondary border-y border-muted-silver/20">
    <div class="mb-16 max-w-2xl">
      <span class="font-label-technical text-label-technical text-accent-performance uppercase block mb-4">HOW_IT_WORKS</span>
      <h2 class="font-display-xl-mobile text-headline-lg-mobile md:text-headline-lg uppercase leading-none">EVERY SERVICE STARTS<br/>THE SAME WAY.</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div>
        <span class="font-label-technical text-label-technical text-accent-performance block mb-4">01</span>
        <h3 class="font-headline-md text-headline-md uppercase mb-3">AUDIT</h3>
        <p class="font-body-md text-body-md text-muted-silver">Free review of your Klaviyo account: flow architecture, active campaigns, list health, and deliverability signals.</p>
      </div>
      <div>
        <span class="font-label-technical text-label-technical text-accent-performance block mb-4">02</span>
        <h3 class="font-headline-md text-headline-md uppercase mb-3">ROADMAP</h3>
        <p class="font-body-md text-body-md text-muted-silver">A prioritized fix list ranked by revenue impact, not a generic 90-day template.</p>
      </div>
      <div>
        <span class="font-label-technical text-label-technical text-accent-performance block mb-4">03</span>
        <h3 class="font-headline-md text-headline-md uppercase mb-3">BUILD</h3>
        <p class="font-body-md text-body-md text-muted-silver">Flows, copy, and segmentation implemented and tested against real data.</p>
      </div>
      <div>
        <span class="font-label-technical text-label-technical text-accent-performance block mb-4">04</span>
        <h3 class="font-headline-md text-headline-md uppercase mb-3">COMPOUND</h3>
        <p class="font-body-md text-body-md text-muted-silver">Ongoing campaigns and optimization. Revenue that compounds monthly instead of resetting.</p>
      </div>
    </div>
    <div class="flex flex-col md:flex-row gap-4 md:gap-10 mt-16">
      <a href="/#ledger" class="inline-flex items-center gap-2 font-label-button uppercase text-accent-performance hover:translate-x-2 transition-transform">
        SEE RESULTS IN THE LEDGER <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
      </a>
      <a href="/industries/" class="inline-flex items-center gap-2 font-label-button uppercase text-muted-silver hover:text-accent-performance transition-colors">
        BROWSE BY INDUSTRY <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
      </a>
      <a href="/platforms/" class="inline-flex items-center gap-2 font-label-button uppercase text-muted-silver hover:text-accent-performance transition-colors">
        NOT ON KLAVIYO? SEE PLATFORMS WE MANAGE <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
      </a>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 md:py-32 px-8 md:px-16 text-center pixel-grid">
    <span class="font-label-technical text-label-technical text-accent-performance uppercase mb-6 block">SYSTEM_CHECK</span>
    <h2 class="font-display-xl-mobile text-headline-lg-mobile md:text-headline-lg uppercase mb-8 leading-tight">NOT SURE WHICH SERVICE<br/>YOU NEED?</h2>
    <p class="font-body-lg text-body-lg text-muted-silver mb-12 max-w-2xl mx-auto italic">Book the free audit. We'll tell you specifically what's underperforming and which service actually fixes it, no upsell required.</p>
    <a href="/#contact" class="inline-block bg-on-surface-warm text-surface-primary px-10 md:px-16 py-6 md:py-8 font-label-button uppercase text-lg md:text-2xl tracking-[0.2em] hover:bg-accent-performance hover:text-on-surface-warm transition-all duration-300">
      GET A FREE AUDIT
    </a>
  </section>
</BaseLayout>

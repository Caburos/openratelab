---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// The Ledger section (below) is intentionally data-driven from the
// caseStudies content collection instead of hand-copied per CLAUDE.md /
// the phase-3 migration spec — this replaces 12 hand-authored slides
// that each showed a different, inconsistent set of stats with a single
// uniform template driven by primaryMetric/heroSubtext. The underlying
// facts per case study are unchanged; only how they're assembled here
// has changed.
const caseStudiesRaw = await getCollection('caseStudies');
const caseStudies = caseStudiesRaw.sort((a, b) =>
  a.data.caseStudyNumber.localeCompare(b.data.caseStudyNumber)
);

// Keep each ledger card's blurb to a reasonable slide-sized length.
function truncate(text: string, max = 150) {
  if (text.length <= max) return text;
  const clipped = text.slice(0, max);
  const lastSpace = clipped.lastIndexOf(' ');
  return (lastSpace > 0 ? clipped.slice(0, lastSpace) : clipped) + '…';
}

// JSON-LD — ported verbatim from index.html's four existing @type blocks
// (Organization, ItemList/Services, ItemList/Reviews, FAQPage), plus a
// WebSite entry as instructed by the migration spec ("Organization +
// WebSite at minimum").
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': 'https://openratelab.com/#organization',
    name: 'OpenRateLab',
    url: 'https://openratelab.com',
    logo: { '@type': 'ImageObject', url: 'https://openratelab.com/images/logo.png' },
    description: 'OpenRateLab builds Klaviyo retention systems and writes conversion copy for e-commerce and DTC brands.',
    email: 'uros@openratelab.com',
    contactPoint: {
      '@type': 'ContactPoint',
      email: 'uros@openratelab.com',
      contactType: 'customer service',
      availableLanguage: 'English',
    },
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: '5',
      reviewCount: '3',
      bestRating: '5',
      worstRating: '1',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': 'https://openratelab.com/#website',
    url: 'https://openratelab.com',
    name: 'OpenRateLab',
    publisher: { '@id': 'https://openratelab.com/#organization' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'OpenRateLab Services',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        item: {
          '@type': 'Service',
          name: 'Email Copywriting',
          description: 'High-performance email copy engineered to convert: welcome flows, campaigns, abandoned cart, win-back, and every lifecycle touchpoint.',
          provider: { '@type': 'Organization', '@id': 'https://openratelab.com/#organization', name: 'OpenRateLab' },
        },
      },
      {
        '@type': 'ListItem',
        position: 2,
        item: {
          '@type': 'Service',
          name: 'Full Email Build',
          description: 'Complete email marketing system built from zero: Klaviyo account setup, flow architecture, segmentation, and campaign calendar.',
          provider: { '@type': 'Organization', '@id': 'https://openratelab.com/#organization', name: 'OpenRateLab' },
        },
      },
      {
        '@type': 'ListItem',
        position: 3,
        item: {
          '@type': 'Service',
          name: 'Klaviyo Automation',
          description: 'Advanced Klaviyo architecture: custom events, dynamic segmentation, predictive analytics, and flow systems built to compound.',
          provider: { '@type': 'Organization', '@id': 'https://openratelab.com/#organization', name: 'OpenRateLab' },
        },
      },
      {
        '@type': 'ListItem',
        position: 4,
        item: {
          '@type': 'Service',
          name: 'Email Strategy',
          description: 'A revenue roadmap built on your data: a list, flow, and segmentation audit, plus a 90-day plan tied to real numbers.',
          provider: { '@type': 'Organization', '@id': 'https://openratelab.com/#organization', name: 'OpenRateLab' },
        },
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'OpenRateLab Client Testimonials',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        item: {
          '@type': 'Review',
          reviewBody: "We've used email before, but it never really moved the needle. This time, email became a consistent revenue channel, not just something we sent occasionally.",
          author: { '@type': 'Person', name: 'Nika' },
          itemReviewed: { '@type': 'Organization', '@id': 'https://openratelab.com/#organization', name: 'OpenRateLab' },
          reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
        },
      },
      {
        '@type': 'ListItem',
        position: 2,
        item: {
          '@type': 'Review',
          reviewBody: 'Email finally made sense as a system. It started bringing sales on autopilot, and it actually supported revenue.',
          author: { '@type': 'Person', name: 'Teia' },
          itemReviewed: { '@type': 'Organization', '@id': 'https://openratelab.com/#organization', name: 'OpenRateLab' },
          reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
        },
      },
      {
        '@type': 'ListItem',
        position: 3,
        item: {
          '@type': 'Review',
          reviewBody: "I didn't expect email to start working this fast. People opened, replied, and bought, and it kept happening without constant sending.",
          author: { '@type': 'Person', name: 'Viktor' },
          itemReviewed: { '@type': 'Organization', '@id': 'https://openratelab.com/#organization', name: 'OpenRateLab' },
          reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
        },
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: "What's included in the free email audit?",
        acceptedAnswer: {
          '@type': 'Answer',
          text: "We review your Klaviyo account: flow architecture, active campaigns, list health, and deliverability signals. You get a written breakdown of what's working, what's not, and what we'd prioritize fixing first. No pitch attached.",
        },
      },
      {
        '@type': 'Question',
        name: 'How long until we see results from Klaviyo flows?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Flow rebuilds typically show measurable impact within the first 30 days, once the welcome sequence and abandonment flows are live. Full system performance compounds over 60–90 days as data accumulates and segments sharpen.',
        },
      },
      {
        '@type': 'Question',
        name: 'Do you work with brands on Shopify or WooCommerce?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: "Yes. We work primarily with Shopify brands, since Klaviyo's Shopify integration is where we're most effective. We also work with WooCommerce accounts where Klaviyo is already the ESP.",
        },
      },
      {
        '@type': 'Question',
        name: "What's a good open rate for Klaviyo emails?",
        acceptedAnswer: {
          '@type': 'Answer',
          text: "Across our active accounts, flows average 40–55%+ and campaigns 35–50%+. Industry averages run 25–30%, but those include broken setups and cold lists. If you're below 30% on flows, something fundamental is wrong with list health, subject line strategy, or both.",
        },
      },
      {
        '@type': 'Question',
        name: 'How does your Klaviyo email management work?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: "We scope each engagement after the audit. Account size, send volume, and whether you need full management or copy-only support all affect scope. The audit is always the right starting point. Book one and we'll give you a straight answer on what your account needs.",
        },
      },
    ],
  },
];
---

<BaseLayout
  title="Klaviyo Email Marketing Agency for DTC Brands | OpenRateLab"
  description="OpenRateLab builds Klaviyo retention systems and email copywriting for e-commerce and DTC brands — automation and copy that compounds revenue."
  canonicalPath="/"
  ogImage="/images/hero-banner.jpg"
  jsonLd={jsonLd}
  isHomepage={true}
>
  <!-- Hero Section -->
  <section id="home" class="relative pt-40 pb-32 px-8 md:px-16 pixel-grid overflow-hidden">
    <div class="grid grid-cols-12 gap-gutter relative z-10">
      <div class="col-span-12 md:col-span-10">
        <span class="font-label-technical text-label-technical text-accent-performance uppercase mb-8 block">[ EMAIL MARKETING AGENCY // KLAVIYO SPECIALISTS ]</span>
        <h1 class="font-display-xl text-display-lg-mobile md:text-display-xl uppercase leading-none tracking-tighter mb-4 break-words">
          KLAVIYO EMAIL MARKETING<br/>FOR DTC BRANDS.
        </h1>
        <p class="font-label-technical text-label-technical text-muted-silver uppercase tracking-[0.15em] mb-12">RETENTION SYSTEMS. EMAIL THAT COMPOUNDS.</p>
      </div>
      <div class="col-span-12 md:col-span-6 md:col-start-7 md:mt-[-40px]">
        <p class="font-body-lg text-body-lg text-muted-silver mb-10 border-l-2 border-accent-performance pl-8 italic">
          Most brands leave 40% of their email revenue untouched. The system is broken. We rebuild it from the ground up: flows that convert, copy that sounds human, and Klaviyo infrastructure that compounds every month.
        </p>
        <div class="flex flex-col items-start gap-4 md:flex-row md:items-center md:gap-8">
          <a href="#contact" class="bg-accent-performance text-on-surface-warm px-8 py-4 md:px-10 md:py-5 font-label-button uppercase text-lg tracking-widest hover:brightness-110 transition-all">
            GET A FREE AUDIT
          </a>
          <span class="font-label-technical text-label-technical text-muted-silver uppercase max-w-[120px]">Response within 24 hours</span>
        </div>
      </div>
    </div>
    <div class="absolute right-0 bottom-0 w-1/3 h-full border-l border-muted-silver/10 pointer-events-none"></div>
  </section>

  <!-- Proof Section -->
  <section id="results" class="bg-surface-secondary border-y border-muted-silver/20 py-24 px-8 md:px-16">
    <div class="mb-16">
      <h2 class="font-label-technical text-label-technical text-muted-silver uppercase tracking-[0.2em] mb-4">KLAVIYO EMAIL RESULTS // THE PERFORMANCE DELTA</h2>
      <div class="rule-line opacity-50"></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-16">
      <div class="flex flex-col">
        <span class="font-label-technical text-label-technical text-accent-performance mb-2">REV_ATTRIBUTED</span>
        <span class="font-display-xl-mobile text-display-xl-mobile md:text-[80px] font-bold font-label-technical leading-none">$1.2M+</span>
        <p class="font-label-button uppercase text-muted-silver mt-4">Email Revenue Generated</p>
      </div>
      <div class="flex flex-col md:border-l border-muted-silver/10 md:pl-16">
        <span class="font-label-technical text-label-technical text-accent-performance mb-2">AVG_OPEN_RATE</span>
        <span class="font-display-xl-mobile text-display-xl-mobile md:text-[80px] font-bold font-label-technical leading-none">33%+</span>
        <p class="font-label-button uppercase text-muted-silver mt-4">Average Open Rate Across Accounts</p>
      </div>
      <div class="flex flex-col md:border-l border-muted-silver/10 md:pl-16">
        <span class="font-label-technical text-label-technical text-accent-performance mb-2">BRANDS_SERVED</span>
        <span class="font-display-xl-mobile text-display-xl-mobile md:text-[80px] font-bold font-label-technical leading-none">22</span>
        <p class="font-label-button uppercase text-muted-silver mt-4">Active Accounts</p>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section id="services" class="py-24 md:py-40 px-8 md:px-16">
    <div class="grid grid-cols-12 gap-gutter mb-24">
      <div class="col-span-12 md:col-span-5">
        <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg uppercase leading-none mb-8">SYSTEMS ARCHITECTURE</h2>
      </div>
      <div class="col-span-12 md:col-span-4 md:col-start-9">
        <p class="font-body-md text-body-md text-muted-silver">
          You don't need more emails. You need a retention system where every subscriber is worth more and every campaign builds on the last. Here's how we build it.
        </p>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-0 border border-muted-silver/20">
      <!-- Service 01 -->
      <div class="p-10 border-r border-b lg:border-b-0 border-muted-silver/20 hover:bg-white/5 transition-colors group">
        <span class="font-label-technical text-label-technical text-accent-performance mb-8 block">01 / COPY</span>
        <h3 class="font-headline-md text-headline-md uppercase mb-6 leading-tight">EMAIL COPYWRITING</h3>
        <p class="font-body-md text-body-md text-muted-silver mb-8">Flows, campaigns, and sequences written to convert. Not to tick a send box. Every word earns its place or it gets cut.</p>
        <a href="#contact" class="flex items-center text-accent-performance font-label-technical group-hover:translate-x-2 transition-transform">
          GET STARTED <span class="material-symbols-outlined ml-2" aria-hidden="true">arrow_forward</span>
        </a>
      </div>
      <!-- Service 02 -->
      <div class="p-10 border-r border-b lg:border-b-0 border-muted-silver/20 hover:bg-white/5 transition-colors group">
        <span class="font-label-technical text-label-technical text-accent-performance mb-8 block">02 / BUILD</span>
        <h3 class="font-headline-md text-headline-md uppercase mb-6 leading-tight">FULL EMAIL BUILD</h3>
        <p class="font-body-md text-body-md text-muted-silver mb-8">No Klaviyo account. No flows. No list hygiene. We build the entire retention system from zero: account setup, flow architecture, segmentation, campaign calendar. Live and earning inside your first month.</p>
        <a href="#contact" class="flex items-center text-accent-performance font-label-technical group-hover:translate-x-2 transition-transform">
          GET STARTED <span class="material-symbols-outlined ml-2" aria-hidden="true">arrow_forward</span>
        </a>
      </div>
      <!-- Service 03 -->
      <div class="p-10 border-r border-b md:border-b-0 border-muted-silver/20 hover:bg-white/5 transition-colors group">
        <span class="font-label-technical text-label-technical text-accent-performance mb-8 block">03 / STACK</span>
        <h3 class="font-headline-md text-headline-md uppercase mb-6 leading-tight">KLAVIYO AUTOMATION</h3>
        <p class="font-body-md text-body-md text-muted-silver mb-8">Full Klaviyo architecture built to spec: custom events, dynamic segmentation, predictive analytics, and flow systems that compound revenue every month without manual work.</p>
        <a href="#contact" class="flex items-center text-accent-performance font-label-technical group-hover:translate-x-2 transition-transform">
          GET STARTED <span class="material-symbols-outlined ml-2" aria-hidden="true">arrow_forward</span>
        </a>
      </div>
      <!-- Service 04 -->
      <div class="p-10 border-muted-silver/20 hover:bg-white/5 transition-colors group">
        <span class="font-label-technical text-label-technical text-accent-performance mb-8 block">04 / PLAN</span>
        <h3 class="font-headline-md text-headline-md uppercase mb-6 leading-tight">EMAIL STRATEGY</h3>
        <p class="font-body-md text-body-md text-muted-silver mb-8">A revenue roadmap built on your data, not a template. We audit your list, flows, and segments, then hand you a 90-day plan tied to real numbers before a single email gets written.</p>
        <a href="#contact" class="flex items-center text-accent-performance font-label-technical group-hover:translate-x-2 transition-transform">
          GET STARTED <span class="material-symbols-outlined ml-2" aria-hidden="true">arrow_forward</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Case Studies: The Ledger -->
  <!--
    Data-driven from the caseStudies content collection (see frontmatter
    above) instead of 12 hand-copied slides. Each card pulls its eyebrow
    tag, composite label, primary metric, and blurb straight from the
    collection so this list can never drift from what's on the individual
    case-study pages.

    NOT reproduced in this pass: the live site's horizontal snap-scroll
    carousel (#ledger-track), the prev/next arrow buttons, the dot
    indicators, and the JS that drives them (scrollTo, IntersectionObserver
    dot-highlighting). This renders instead as a static stacked grid of
    all 12 entries. Carousel interactivity is deferred to a later phase.
  -->
  <section id="ledger" class="py-24 md:py-40 bg-surface-primary overflow-x-hidden">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4 mb-16 px-8 md:px-16">
      <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg uppercase">THE LEDGER</h2>
      <span class="font-label-technical text-label-technical text-muted-silver md:pb-4">[ RECENT_DEPLOYMENTS ]</span>
    </div>

    <div class="px-8 md:px-16">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border-t border-l border-muted-silver/20">
        {caseStudies.map((entry) => (
          <div class="p-8 md:p-10 border-r border-b border-muted-silver/20 flex flex-col justify-between min-h-[380px]">
            <div>
              <span class="font-label-technical text-label-technical text-accent-performance mb-4 block">
                [ THE LEDGER / CASE_STUDY:{entry.data.caseStudyNumber} // {entry.data.industryLabel.toUpperCase()} ]
              </span>
              {entry.data.isComposite && (
                <span class="font-label-technical text-label-technical text-muted-silver uppercase block mb-6">COMPOSITE CASE STUDY</span>
              )}
              <div class="font-display-xl-mobile text-display-xl-mobile font-black text-accent-performance leading-none mb-2">{entry.data.primaryMetric.value}</div>
              <span class="font-label-button uppercase text-muted-silver block mb-6">{entry.data.primaryMetric.label}</span>
              <p class="font-body-md text-body-md text-muted-silver mb-8">{truncate(entry.data.heroSubtext)}</p>
            </div>
            <a href={`/case-studies/${entry.id}`} class="w-full py-4 border border-on-surface-warm text-on-surface-warm font-label-button uppercase hover:bg-on-surface-warm hover:text-surface-primary transition-all text-center">READ FULL CASE STUDY</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <!--
    Reproduced verbatim from index.html. Testimonial role/title accuracy
    is a known issue tracked separately by the site owner in an unrelated
    work stream — intentionally not touched here.
  -->
  <section id="testimonials" class="py-24 md:py-40 px-8 md:px-16 bg-surface-secondary">
    <div class="mb-16">
      <h2 class="font-label-technical text-label-technical text-muted-silver uppercase tracking-[0.2em] mb-4">CLIENT TESTIMONIALS // CLIENT SIGNAL</h2>
      <div class="rule-line opacity-50"></div>
    </div>
    <div class="space-y-0 border-t border-muted-silver/20">

      <!-- Testimonial: Nika -->
      <div class="grid grid-cols-12 gap-gutter py-16 border-b border-muted-silver/20 group hover:bg-white/2 transition-colors">
        <div class="col-span-12 md:col-span-1 flex items-start pt-1">
          <img src="/images/testimonial-nika.jpg" alt="Nika, E-commerce founder" class="w-12 h-12 object-cover grayscale opacity-70 group-hover:opacity-100 group-hover:grayscale-0 transition-all duration-500" width="200" height="200" loading="lazy"/>
        </div>
        <div class="col-span-12 md:col-span-7 md:col-start-2">
          <p class="font-body-lg text-body-lg text-on-surface-warm italic mb-6 leading-relaxed">
            "We've used email before, but it never really moved the needle. This time, email became a consistent revenue channel, not just something we sent occasionally."
          </p>
          <div class="flex items-center gap-6">
            <span class="font-label-technical text-label-technical text-accent-performance uppercase">NIKA</span>
            <span class="font-label-technical text-label-technical text-muted-silver uppercase">// E-COMMERCE FOUNDER</span>
          </div>
        </div>
        <div class="col-span-12 md:col-span-3 md:col-start-10 flex items-center justify-start md:justify-end mt-2 md:mt-0">
          <span class="font-label-technical text-label-technical text-accent-performance uppercase border border-accent-performance/30 px-4 py-2">WELCOME FLOW</span>
        </div>
      </div>

      <!-- Testimonial: Teia -->
      <div class="grid grid-cols-12 gap-gutter py-16 border-b border-muted-silver/20 group hover:bg-white/2 transition-colors">
        <div class="col-span-12 md:col-span-1 flex items-start pt-1">
          <img src="/images/testimonial-teia.jpg" alt="Teia, DTC brand owner" class="w-12 h-12 object-cover grayscale opacity-70 group-hover:opacity-100 group-hover:grayscale-0 transition-all duration-500" width="200" height="200" loading="lazy"/>
        </div>
        <div class="col-span-12 md:col-span-7 md:col-start-2">
          <p class="font-body-lg text-body-lg text-on-surface-warm italic mb-6 leading-relaxed">
            "Email finally made sense as a system. It started bringing sales on autopilot, and it actually supported revenue."
          </p>
          <div class="flex items-center gap-6">
            <span class="font-label-technical text-label-technical text-accent-performance uppercase">TEIA</span>
            <span class="font-label-technical text-label-technical text-muted-silver uppercase">// DTC BRAND OWNER</span>
          </div>
        </div>
        <div class="col-span-12 md:col-span-3 md:col-start-10 flex items-center justify-start md:justify-end mt-2 md:mt-0">
          <span class="font-label-technical text-label-technical text-accent-performance uppercase border border-accent-performance/30 px-4 py-2">EMAIL COPY</span>
        </div>
      </div>

      <!-- Testimonial: Viktor -->
      <div class="grid grid-cols-12 gap-gutter py-16 border-b border-muted-silver/20 group hover:bg-white/2 transition-colors">
        <div class="col-span-12 md:col-span-1 flex items-start pt-1">
          <img src="/images/testimonial-viktor.jpg" alt="Viktor, Growth director" class="w-12 h-12 object-cover grayscale opacity-70 group-hover:opacity-100 group-hover:grayscale-0 transition-all duration-500" width="200" height="200" loading="lazy"/>
        </div>
        <div class="col-span-12 md:col-span-7 md:col-start-2">
          <p class="font-body-lg text-body-lg text-on-surface-warm italic mb-6 leading-relaxed">
            "I didn't expect email to start working this fast. People opened, replied, and bought, and it kept happening without constant sending."
          </p>
          <div class="flex items-center gap-6">
            <span class="font-label-technical text-label-technical text-accent-performance uppercase">VIKTOR</span>
            <span class="font-label-technical text-label-technical text-muted-silver uppercase">// GROWTH DIRECTOR</span>
          </div>
        </div>
        <div class="col-span-12 md:col-span-3 md:col-start-10 flex items-center justify-start md:justify-end mt-2 md:mt-0">
          <span class="font-label-technical text-label-technical text-accent-performance uppercase border border-accent-performance/30 px-4 py-2">FULL FUNNEL</span>
        </div>
      </div>

    </div>
  </section>

  <!-- Expertise: Capabilities Spec Sheet -->
  <section id="expertise" class="py-24 md:py-40 px-8 md:px-16 bg-surface-primary">
    <div class="grid grid-cols-12 gap-gutter">
      <div class="col-span-12 md:col-span-4">
        <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg uppercase mb-8">CAPABILITIES</h2>
        <p class="font-body-md text-body-md text-muted-silver">The full stack of what we do. No fluff. Only the skills that actually move revenue for e-commerce and DTC brands.</p>
      </div>
      <div class="col-span-12 md:col-span-7 md:col-start-6">
        <div class="space-y-0 border-t border-muted-silver/20">
          <div class="flex justify-between items-center py-8 border-b border-muted-silver/20 group hover:px-4 transition-all cursor-default">
            <div class="flex items-center space-x-8">
              <span class="font-label-technical text-label-technical text-accent-performance">01</span>
              <span class="font-headline-md text-headline-md uppercase">KLAVIYO</span>
            </div>
            <span class="font-label-technical text-label-technical text-muted-silver hidden md:block">PLATFORM_ARCHITECTURE</span>
          </div>
          <div class="flex justify-between items-center py-8 border-b border-muted-silver/20 group hover:px-4 transition-all cursor-default">

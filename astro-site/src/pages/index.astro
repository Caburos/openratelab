---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// The Ledger section (below) is intentionally data-driven from the
// caseStudies content collection instead of hand-copied per CLAUDE.md /
// the phase-3 migration spec — this replaces 12 hand-authored slides
// that each showed a different, inconsistent set of stats with a single
// uniform template driven by primaryMetric/heroSubtext. The underlying
// facts per case study are unchanged; only how they're assembled here
// has changed.
const caseStudiesRaw = await getCollection('caseStudies');
const caseStudies = caseStudiesRaw.sort((a, b) =>
  a.data.caseStudyNumber.localeCompare(b.data.caseStudyNumber)
);

// Keep each ledger card's blurb to a reasonable slide-sized length.
function truncate(text: string, max = 150) {
  if (text.length <= max) return text;
  const clipped = text.slice(0, max);
  const lastSpace = clipped.lastIndexOf(' ');
  return (lastSpace > 0 ? clipped.slice(0, lastSpace) : clipped) + '…';
}

// JSON-LD — ported verbatim from index.html's four existing @type blocks

  <script>
    // Netlify Forms — AJAX submit with inline success message, plus a
    // parallel call to the Resend-backed function so notification email
    // delivery doesn't depend on Netlify's own dashboard notification
    // settings. Ported from the live static site's inline script.
    (() => {
      const contactForm = document.querySelector('form[name="contact"]');
      if (contactForm) {
        contactForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const btn = contactForm.querySelector('button[type="submit"]') as HTMLButtonElement;
          const orig = btn.textContent;
          btn.textContent = 'SENDING...';
          btn.disabled = true;

          const formData = new FormData(contactForm as HTMLFormElement);
          const netlifyCapture = fetch('/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(formData as unknown as Record<string, string>).toString(),
          });
          const emailSend = fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: formData.get('name'),
              email: formData.get('email'),
              service: formData.get('brand'),
              esp: formData.get('esp'),
              platform: formData.get('platform'),
              revenueRange: formData.get('revenue_range'),
              challenge: formData.getAll('challenge').join(', '),
              timeline: formData.get('timeline'),
              message: formData.get('message'),
            }),
          }).catch(() => {});

          Promise.all([netlifyCapture, emailSend])
            .then(([r]) => {
              if (r.ok) {
                contactForm.innerHTML = '<p class="font-label-technical text-label-technical text-accent-performance uppercase py-8 tracking-widest">TRANSMISSION RECEIVED. WE\'LL BE IN TOUCH WITHIN 24 HOURS.</p>';
              } else {
                btn.textContent = orig;
                btn.disabled = false;
              }
            })
            .catch(() => {
              btn.textContent = orig;
              btn.disabled = false;
            });
        });
      }
    })();

    // Multi-step reveal for the contact form's qualifying questions.
    // All 8 steps exist in the raw HTML (progressive enhancement) — this
    // only hides steps 2+ if it successfully initializes, the same
    // "apply hiding via inline style, never a static CSS rule" pattern
    // as the reveal-animation script below: if this script errors or
    // never runs, every field stays visible and the form still submits
    // as a normal long-form.
    (() => {
      const form = document.querySelector('form[name="contact"]');
      if (!form) return;
      const steps = Array.from(form.querySelectorAll<HTMLElement>('.form-step'));
      const progressBar = document.getElementById('form-progress-bar');
      const progressLabel = document.getElementById('form-progress-label');
      if (!steps.length || !progressBar || !progressLabel) return;

      const total = steps.length;
      let current = 1;

      const showStep = (n: number) => {
        steps.forEach((step) => {
          const isTarget = parseInt(step.dataset.step || '0', 10) === n;
          step.style.display = isTarget ? '' : 'none';
        });
        progressBar.style.width = (n / total) * 100 + '%';
        progressLabel.textContent = `STEP ${n} OF ${total}`;
        current = n;
      };

      const goNext = () => { if (current < total) showStep(current + 1); };
      const goPrev = () => { if (current > 1) showStep(current - 1); };

      steps.forEach((step) => {
        const nextBtn = step.querySelector<HTMLButtonElement>('.step-next');
        const backBtn = step.querySelector<HTMLButtonElement>('.step-back');
        const errorEl = step.querySelector<HTMLElement>('.step-error');

        if (nextBtn) {
          nextBtn.addEventListener('click', () => {
            const nameInput = step.querySelector<HTMLInputElement>('input[name="name"]');
            const emailInput = step.querySelector<HTMLInputElement>('input[name="email"]');
            if (nameInput && emailInput) {
              if (!nameInput.value.trim()) {
                if (errorEl) { errorEl.textContent = 'Please enter your name.'; errorEl.classList.remove('hidden'); }
                nameInput.focus();
                return;
              }
              if (!emailInput.checkValidity()) {
                if (errorEl) { errorEl.textContent = 'Please enter a valid email.'; errorEl.classList.remove('hidden'); }
                emailInput.focus();
                return;
              }
              if (errorEl) errorEl.classList.add('hidden');
            }
            goNext();
          });
        }
        if (backBtn) backBtn.addEventListener('click', goPrev);

        // Selects auto-advance once a real option is chosen — the whole
        // point of "reveal the next question when something is selected."
        const autoSelect = step.querySelector<HTMLSelectElement>('select[data-autoadvance]');
        if (autoSelect) {
          autoSelect.addEventListener('change', () => {
            if (autoSelect.value) setTimeout(goNext, 250);
          });
        }
      });

      showStep(1);
    })();

    // Lead magnet form — same AJAX pattern as the main contact form, but
    // email-only. /api/contact only requires `email` (name/message are
    // optional there specifically so this lighter form can reuse it).
    (() => {
      const leadForm = document.querySelector('form[name="lead-magnet"]');
      if (leadForm) {
        leadForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const btn = leadForm.querySelector('button[type="submit"]') as HTMLButtonElement;
          const orig = btn.textContent;
          btn.textContent = 'SENDING...';
          btn.disabled = true;

          const formData = new FormData(leadForm as HTMLFormElement);
          const netlifyCapture = fetch('/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(formData as unknown as Record<string, string>).toString(),
          });
          const emailSend = fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: formData.get('email') }),
          }).catch(() => {});

          Promise.all([netlifyCapture, emailSend])
            .then(([r]) => {
              if (r.ok) {
                leadForm.innerHTML = '<p class="font-label-technical text-label-technical text-accent-performance uppercase py-4 tracking-widest">CHECK YOUR INBOX SHORTLY.</p>';
              } else {
                btn.textContent = orig;
                btn.disabled = false;
              }
            })
            .catch(() => {
              btn.textContent = orig;
              btn.disabled = false;
            });
        });
      }
    })();

    // ROI calculator: live revenue-gap projection. Pure arithmetic, no
    // network calls — revenue * attribution% = current, revenue *
    // targetPct% = target, delta = target - current.
    (() => {
      const revenueInput = document.getElementById('calc-revenue') as HTMLInputElement;
      const attributionInput = document.getElementById('calc-attribution') as HTMLInputElement;
      const revenueDisplay = document.getElementById('calc-revenue-display');
      const attributionDisplay = document.getElementById('calc-attribution-display');
      const currentRevenueEl = document.getElementById('calc-current-revenue');
      const targetPctEl = document.getElementById('calc-target-pct');
      const targetRevenueEl = document.getElementById('calc-target-revenue');
      const deltaEl = document.getElementById('calc-delta');
      const scenarioBtns = document.querySelectorAll<HTMLButtonElement>('.calc-scenario-btn');
      if (!revenueInput || !attributionInput || !revenueDisplay || !attributionDisplay || !currentRevenueEl || !targetPctEl || !targetRevenueEl || !deltaEl || !scenarioBtns.length) return;

      let targetPct = 30;

      const fmt = (n: number) => '$' + Math.round(n).toLocaleString('en-US');

      const recalc = () => {
        const revenue = parseFloat(revenueInput.value);
        const attribution = parseFloat(attributionInput.value);
        revenueDisplay.textContent = fmt(revenue);
        attributionDisplay.textContent = attribution + '%';

        const currentRevenue = revenue * (attribution / 100);
        currentRevenueEl.textContent = fmt(currentRevenue) + '/mo';

        const targetRevenue = revenue * (targetPct / 100);
        const delta = Math.max(0, targetRevenue - currentRevenue);
        targetPctEl.textContent = targetPct + '%' + (targetPct === 30 ? '+' : '');
        targetRevenueEl.textContent = fmt(targetRevenue) + '/mo';
        deltaEl.textContent = '+' + fmt(delta) + '/mo';
      };

      revenueInput.addEventListener('input', recalc);
      attributionInput.addEventListener('input', recalc);
      scenarioBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          targetPct = parseFloat(btn.dataset.pct || '30');
          scenarioBtns.forEach((b) => {
            b.classList.remove('border-accent-performance', 'bg-accent-performance', 'text-on-surface-warm');
            b.classList.add('border-muted-silver/30');
          });
          btn.classList.remove('border-muted-silver/30');
          btn.classList.add('border-accent-performance', 'bg-accent-performance', 'text-on-surface-warm');
          recalc();
        });
      });

      recalc();
    })();

    // Smooth-scroll for in-page anchor links, offset for the fixed nav.
    (() => {
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener('click', function (this: HTMLAnchorElement, e) {
          const targetId = this.getAttribute('href');
          if (!targetId || targetId === '#') return;
          const target = document.querySelector(targetId);
          if (target) {
            e.preventDefault();
            const navHeight = 80;
            const top = target.getBoundingClientRect().top + window.scrollY - navHeight;
            window.scrollTo({ top, behavior: 'smooth' });
          }
        });
      });
    })();

    // Ledger case-study slider: scroll-snap track driven by prev/next
    // buttons + clickable dots. All 12 cards are always in the DOM
    // (crawlable); this only controls scroll position.
    (() => {
      const track = document.getElementById('ledger-track');
      const prevBtn = document.getElementById('ledger-prev');
      const nextBtn = document.getElementById('ledger-next');
      const dotsWrap = document.getElementById('ledger-dots');
      if (!track || !dotsWrap || !prevBtn || !nextBtn) return;

      const slides = Array.from(track.querySelectorAll<HTMLElement>('.ledger-slide'));
      const goTo = (i: number) => {
        const clamped = Math.max(0, Math.min(slides.length - 1, i));
        track.scrollTo({ left: slides[clamped].offsetLeft, behavior: 'smooth' });
      };
      const currentIndex = () => {
        let closest = 0;
        let closestDist = Infinity;
        slides.forEach((s, i) => {
          const dist = Math.abs(s.offsetLeft - track.scrollLeft);
          if (dist < closestDist) { closestDist = dist; closest = i; }
        });
        return closest;
      };
      slides.forEach((_, i) => {
        const dot = document.createElement('button');
        dot.className = 'w-2.5 h-2.5 rounded-full bg-muted-silver/30 ledger-dot transition-colors';
        dot.setAttribute('aria-label', 'Go to case study ' + (i + 1));
        dot.addEventListener('click', () => goTo(i));
        dotsWrap.appendChild(dot);
      });
      const dots = dotsWrap.querySelectorAll('.ledger-dot');
      const updateDots = () => {
        const index = currentIndex();
        dots.forEach((d, i) => d.classList.toggle('bg-accent-performance', i === index));
      };
      updateDots();
      track.addEventListener('scroll', () => window.requestAnimationFrame(updateDots));
      prevBtn.addEventListener('click', () => goTo(currentIndex() - 1));
      nextBtn.addEventListener('click', () => goTo(currentIndex() + 1));
    })();

    // Nav scroll-spy: highlight the nav link for the section currently in view.
    (() => {
      const navLinks = document.querySelectorAll('.nav-link');
      const spySections = Array.from(document.querySelectorAll('section[id]'));
      if (navLinks.length && spySections.length) {
        const setActive = (id: string) => {
          navLinks.forEach((link) => {
            const active = (link as HTMLElement).dataset.section === id;
            link.classList.toggle('text-accent-performance', active);
            link.classList.toggle('font-bold', active);
            link.classList.toggle('border-accent-performance', active);
            link.classList.toggle('border-transparent', !active);
          });
        };
        const spyObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) setActive(entry.target.id);
            });
          },
          { rootMargin: '-40% 0px -55% 0px', threshold: 0 }
        );
        spySections.forEach((section) => spyObserver.observe(section));
      }
    })();

    // Scroll-triggered reveal animations. Purely presentational, and
    // fail-safe by construction: the "start hidden" state is only ever
    // set as an inline style, applied right here — if this script errors,
    // gets blocked, or IntersectionObserver is unsupported, elements are
    // simply never hidden in the first place (the CSS classes carry no
    // hiding rule of their own, only the transition property). A prior
    // version hid content via a plain CSS class with no such fallback,
    // which broke in production (case studies/services/testimonials
    // stayed permanently invisible). A hard timeout below is a second,
    // independent safety net in case an observer is created but never
    // fires for some element.
    (() => {
      if (!('IntersectionObserver' in window)) return;

      const wipeTargets = document.querySelectorAll<HTMLElement>('#services .grid, #ledger .grid, #testimonials .grid, #expertise .grid');
      wipeTargets.forEach((el) => {
        el.classList.add('reveal-wipe');
        el.style.clipPath = 'inset(0 100% 0 0)';
      });

      const leftTargets = document.querySelectorAll<HTMLElement>('#results h2, #testimonials h2, #services h2, #ledger h2, #expertise h2');
      leftTargets.forEach((el) => {
        el.classList.add('reveal-left');
        el.style.opacity = '0';
        el.style.transform = 'translateX(-24px)';
      });

      const lineTargets = document.querySelectorAll<HTMLElement>('#results .rule-line, #testimonials .rule-line');
      lineTargets.forEach((el) => {
        el.style.transform = 'scaleX(0)';
      });

      const allTargets = [...wipeTargets, ...leftTargets, ...lineTargets];

      const reveal = (el: HTMLElement) => {
        el.style.clipPath = '';
        el.style.opacity = '';
        el.style.transform = '';
        el.classList.add('in-view');
      };

      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              reveal(entry.target as HTMLElement);
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.05, rootMargin: '0px 0px -10% 0px' }
      );

      allTargets.forEach((el) => revealObserver.observe(el));

      // Hard fallback: whatever hasn't revealed itself within 4s (an
      // observer edge case, a very short page, etc.) just gets revealed
      // directly. Content is never permanently hidden.
      setTimeout(() => {
        allTargets.forEach((el) => {
          if (!el.classList.contains('in-view')) reveal(el);
        });
      }, 4000);

      // Count-up on the #results stat numbers. Ends on the exact original
      // text every time, so the final DOM state always matches raw HTML.
      const counters = document.querySelectorAll('#results span.font-display-xl-mobile');
      const countObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            countObserver.unobserve(entry.target);
            const el = entry.target as HTMLElement;
            const finalText = el.textContent || '';
            const match = finalText.match(/[\d.]+/);
            if (!match || match.index === undefined) return;
            const targetNum = parseFloat(match[0]);
            const prefix = finalText.slice(0, match.index);
            const suffix = finalText.slice(match.index + match[0].length);
            const decimals = (match[0].split('.')[1] || '').length;
            const duration = 1200;
            let start: number | null = null;
            function tick(ts: number) {
              if (start === null) start = ts;
              const progress = Math.min((ts - start) / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              el.textContent = prefix + (targetNum * eased).toFixed(decimals) + suffix;
              if (progress < 1) requestAnimationFrame(tick);
              else el.textContent = finalText;
            }
            requestAnimationFrame(tick);
          });
        },
        { threshold: 0.5 }
      );
      counters.forEach((el) => countObserver.observe(el));
    })();


    // Cross-browser mobile motion fallback. The heavier CSS motion layer uses
    // view timelines, which are still inconsistent across mobile browsers.
    // On mobile (and any desktop browser without that API), this observer +
    // Web Animations implementation recreates the same assembly language:
    // panels construct, red rails shoot in, process nodes deploy in sequence,
    // and proof lines carry a short red signal. Nothing is pre-hidden, so a
    // JS failure still leaves a fully usable static page.
    (() => {
      if (!('IntersectionObserver' in window) || !('animate' in Element.prototype)) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const isMobile = window.matchMedia('(max-width: 767px)').matches;
      const hasViewTimeline = typeof CSS !== 'undefined' && typeof CSS.supports === 'function' && CSS.supports('animation-timeline: view()');
      if (!isMobile && hasViewTimeline) return;

      document.documentElement.classList.add('orl-motion-fallback');

      const motionReset = document.createElement('style');
      motionReset.textContent = `
        html.orl-motion-fallback #diagnosis *, html.orl-motion-fallback #diagnosis *::before, html.orl-motion-fallback #diagnosis *::after,
        html.orl-motion-fallback #services *, html.orl-motion-fallback #services *::before, html.orl-motion-fallback #services *::after,
        html.orl-motion-fallback #results *, html.orl-motion-fallback #results *::before, html.orl-motion-fallback #results *::after,
        html.orl-motion-fallback #process *, html.orl-motion-fallback #process *::before, html.orl-motion-fallback #process *::after,
        html.orl-motion-fallback #expertise *, html.orl-motion-fallback #expertise *::before, html.orl-motion-fallback #expertise *::after,
        html.orl-motion-fallback #testimonials *, html.orl-motion-fallback #testimonials *::before, html.orl-motion-fallback #testimonials *::after,
        html.orl-motion-fallback #ledger *, html.orl-motion-fallback #ledger *::before, html.orl-motion-fallback #ledger *::after,
        html.orl-motion-fallback #why-us *, html.orl-motion-fallback #why-us *::before, html.orl-motion-fallback #why-us *::after,
        html.orl-motion-fallback #calculator *, html.orl-motion-fallback #calculator *::before, html.orl-motion-fallback #calculator *::after,
        html.orl-motion-fallback #lead-magnet *, html.orl-motion-fallback #lead-magnet *::before, html.orl-motion-fallback #lead-magnet *::after,
        html.orl-motion-fallback #contact *, html.orl-motion-fallback #contact *::before, html.orl-motion-fallback #contact *::after {
          animation: none !important;
        }
      `;
      document.head.appendChild(motionReset);

      document.querySelectorAll<HTMLElement>('.reveal-wipe').forEach((el) => {
        el.classList.remove('reveal-wipe');
        el.style.clipPath = '';
      });

      const once = new WeakSet<Element>();
      const accent = '#E63946';
      const warm = '#F9F9F7';

      const temporary = (parent: HTMLElement, styles: Partial<CSSStyleDeclaration>) => {
        const node = document.createElement('span');
        Object.assign(node.style, {
          position: 'absolute',
          display: 'block',
          pointerEvents: 'none',
          zIndex: '8',
          ...styles,
        });
        if (getComputedStyle(parent).position === 'static') parent.style.position = 'relative';
        parent.appendChild(node);
        return node;
      };

      const shootRail = (el: HTMLElement, vertical = false, delay = 100) => {
        const rail = temporary(el, vertical ? {
          top: '-1px', bottom: '-1px', left: '-1px', width: '3px', background: accent,
          transform: 'scaleY(0)', transformOrigin: 'center top', boxShadow: `0 0 14px ${accent}55`,
        } : {
          top: '-1px', left: '-1px', width: 'calc(100% + 2px)', height: '3px', background: accent,
          transform: 'scaleX(0)', transformOrigin: 'left center', boxShadow: `0 0 14px ${accent}55`,
        });
        const anim = rail.animate(
          vertical
            ? [{ transform: 'scaleY(0)', opacity: .8 }, { transform: 'scaleY(1)', opacity: 1 }]
            : [{ transform: 'scaleX(0)', opacity: .8 }, { transform: 'scaleX(1)', opacity: 1 }],
          { duration: 430, delay, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'both' }
        );
        anim.finished.then(() => rail.remove()).catch(() => rail.remove());
      };

      const impactMetric = (el: HTMLElement, delay = 230) => {
        el.animate(
          [
            { transform: 'scale(.92)', opacity: .42 },
            { transform: 'scale(1.045)', opacity: 1, offset: .7 },
            { transform: 'scale(1)', opacity: 1 },
          ],
          { duration: 520, delay, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' }
        );
      };

      const assemblePanel = (el: HTMLElement) => {
        if (once.has(el)) return;
        once.add(el);

        const siblings = el.parentElement ? Array.from(el.parentElement.children) : [];
        const index = Math.max(0, siblings.indexOf(el));
        const delay = Math.min(index % 4, 3) * 55;

        const tracer = temporary(el, {
          inset: '-1px',
          border: `1px solid ${warm}B8`,
          clipPath: 'inset(0 100% 100% 0)',
          opacity: '0',
        });
        const frame = tracer.animate(
          [
            { clipPath: 'inset(0 100% 100% 0)', opacity: 0 },
            { clipPath: 'inset(0 100% 100% 0)', opacity: 1, offset: .12 },
            { clipPath: 'inset(0 0 0 0)', opacity: 1, offset: .78 },
            { clipPath: 'inset(0 0 0 0)', opacity: 0 },
          ],
          { duration: 720, delay, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'both' }
        );
        frame.finished.then(() => tracer.remove()).catch(() => tracer.remove());

        el.animate(
          [
            { transform: 'translateY(18px) scale(.985)', filter: 'brightness(.82)', opacity: .48 },
            { transform: 'translateY(0) scale(1.008)', filter: 'brightness(1.04)', opacity: 1, offset: .76 },
            { transform: 'translateY(0) scale(1)', filter: 'brightness(1)', opacity: 1 },
          ],
          { duration: 680, delay, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' }
        );

        if (el.matches('#diagnosis > div:last-child > div:last-child')) shootRail(el, true, delay + 120);
        if (el.matches('#services > div:last-child > div, #results > div:last-child > div, #ledger .ledger-slide, #lead-magnet > div, #calculator > div:nth-child(2) > div:last-child, #contact > div > div:last-child')) {
          shootRail(el, false, delay + 120);
        }

        const metric = el.querySelector<HTMLElement>('#calc-target-revenue, span.font-display-xl-mobile, .font-display-xl-mobile');
        if (metric) impactMetric(metric, delay + 240);
      };

      const panelSelector = [
        '#diagnosis > div:last-child > div',
        '#services > div:last-child > div',
        '#results > div:last-child > div',
        '#testimonials > div:last-child > div',
        '#ledger .ledger-slide',
        '#why-us > div:last-child > div',
        '#calculator > div:nth-child(2) > div',
        '#lead-magnet > div',
        '#lead-magnet + section .grid > a',
        '#contact > div > div:last-child',
      ].join(',');

      const panelObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          assemblePanel(entry.target as HTMLElement);
          observer.unobserve(entry.target);
        });
      }, { threshold: .12, rootMargin: '0px 0px -7% 0px' });
      document.querySelectorAll<HTMLElement>(panelSelector).forEach((el) => panelObserver.observe(el));

      const process = document.querySelector<HTMLElement>('#process > div:last-child');
      if (process) {
        const processObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting || once.has(process)) return;
            once.add(process);
            observer.unobserve(process);

            const vertical = window.matchMedia('(max-width: 767px)').matches;
            const rail = temporary(process, vertical ? {
              top: '4px', bottom: '0', left: '6px', width: '2px', background: accent,
              transform: 'scaleY(0)', transformOrigin: 'center top', zIndex: '3',
            } : {
              top: '6px', left: '0', right: '0', height: '2px', background: accent,
              transform: 'scaleX(0)', transformOrigin: 'left center', zIndex: '3',
            });
            rail.animate(
              vertical ? [{ transform: 'scaleY(0)' }, { transform: 'scaleY(1)' }] : [{ transform: 'scaleX(0)' }, { transform: 'scaleX(1)' }],
              { duration: 1150, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'both' }
            );

            Array.from(process.children).forEach((child, index) => {
              const step = child as HTMLElement;
              const delay = 120 + index * 190;
              step.animate(
                [{ opacity: .22, transform: 'translateY(15px)' }, { opacity: 1, transform: 'translateY(0)' }],
                { duration: 520, delay, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'both' }
              );
              const node = temporary(step, vertical ? {
                top: '2px', left: '0', width: '13px', height: '13px', background: accent,
                border: `2px solid ${accent}`, transform: 'scale(0)', transformOrigin: 'center',
              } : {
                top: '-27px', left: '0', width: '13px', height: '13px', background: accent,
                border: `2px solid ${accent}`, transform: 'scale(0)', transformOrigin: 'center',
              });
              const nodeAnim = node.animate(
                [{ transform: 'scale(0)' }, { transform: 'scale(1.35)', offset: .68 }, { transform: 'scale(1)' }],
                { duration: 400, delay, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'both' }
              );
              nodeAnim.finished.then(() => node.remove()).catch(() => node.remove());
            });
          });
        }, { threshold: .14, rootMargin: '0px 0px -10% 0px' });
        processObserver.observe(process);
      }

      const lineObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const line = entry.target as HTMLElement;
          observer.unobserve(line);
          line.style.position = 'relative';
          line.style.overflow = 'hidden';
          const packet = temporary(line, {
            top: '0', left: '-80px', width: '68px', height: '1px', background: accent,
            boxShadow: `0 0 10px ${accent}77`,
          });
          const distance = Math.max(line.clientWidth + 170, 360);
          const packetAnim = packet.animate(
            [
              { transform: 'translateX(0)', opacity: 0 },
              { transform: 'translateX(35px)', opacity: 1, offset: .12 },
              { transform: `translateX(${distance}px)`, opacity: 1, offset: .84 },
              { transform: `translateX(${distance + 35}px)`, opacity: 0 },
            ],
            { duration: 850, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'both' }
          );
          packetAnim.finished.then(() => packet.remove()).catch(() => packet.remove());
        });
      }, { threshold: .2 });
      document.querySelectorAll<HTMLElement>('#results .rule-line, #testimonials .rule-line, #expertise .border-t').forEach((el) => lineObserver.observe(el));

      const editorialObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          observer.unobserve(entry.target);
          (entry.target as HTMLElement).animate(
            [{ opacity: .35, transform: 'translateX(-12px)' }, { opacity: 1, transform: 'translateX(0)' }],
            { duration: 460, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' }
          );
        });
      }, { threshold: .18 });
      document.querySelectorAll<HTMLElement>('#expertise .border-b, #calculator + section details').forEach((el) => editorialObserver.observe(el));
    })();
  </script>
</BaseLayout>

<style>
  /*
    Content must always be visible regardless of JS. A prior version of
    this animation hid content (clip-path/opacity) until a JS
    IntersectionObserver added .in-view, with no fallback — when the
    observer didn't fire in a real browser, case studies/services/
    testimonials stayed permanently invisible in production. Fixed: no
    class here ever hides content. .in-view is now purely a one-time
    transition trigger (see the JS below, which sets the *starting*
    hidden state as an inline style applied and removed in the same task,
    with a hard requestAnimationFrame-based fallback) — if JS never runs
    at all, elements simply have no animation and are fully visible,
    which is the correct failure mode.
  */
  .reveal-wipe {
    transition: clip-path 1.1s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal-left {
    transition: opacity 0.9s ease-out, transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .rule-line {
    transform-origin: left;
    transition: transform 1s cubic-bezier(0.16, 1, 0.3, 1);
  }
</style>

<style>
  /* Capabilities list: prevent long capability names from overflowing on
     mobile. Ported from index.html's inline <style> block — this is a
     layout fix, not one of the deferred scroll-reveal animations. */
  #expertise :global(.text-headline-md) {
    font-size: 1rem;
    line-height: 1.5rem;
    font-weight: 600;
  }
  @media (min-width: 768px) {
    #expertise :global(.text-headline-md) {
      font-size: 32px;
      line-height: 40px;
    }
  }
</style>

---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath: string; // e.g. "/case-studies/health-supplement-brand-at-scale" (no trailing slash) or "/about/" (with)
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: 'website' | 'article';
  jsonLd?: object[]; // pre-built @graph array entries, page decides its own schema shapes
  activeNav?: 'services' | 'case-studies' | 'about' | 'blog' | 'contact' | null;
  isHomepage?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  ogImage = '/images/og-image.png',
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogType = 'website',
  jsonLd,
  activeNav = null,
  isHomepage = false,
} = Astro.props;

const canonicalUrl = `https://openratelab.com${canonicalPath}`;

const navLinkBase =
  'text-on-surface-warm font-label-button uppercase hover:text-accent-performance transition-colors duration-150';
const navLinkActive = 'text-accent-performance font-label-button uppercase transition-colors duration-150';
function navClass(section: typeof activeNav) {
  const active = activeNav === section;
  if (section === 'blog' && active) {
    return `${navLinkActive} border-b border-accent-performance`;
  }
  return active ? navLinkActive : navLinkBase;
}
---

<!DOCTYPE html>
<html class="dark" lang="en">
<head>
<meta charset="utf-8" />
<meta content="width=device-width, initial-scale=1.0" name="viewport" />

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-1BTX88Q3NG"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){window.dataLayer.push(arguments);}
  // @ts-ignore
  gtag('js', new Date());
  // @ts-ignore
  gtag('config', 'G-1BTX88Q3NG');
</script>

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<meta name="theme-color" content="#0D0D0D" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="canonical" href={canonicalUrl} />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="OpenRateLab" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={`https://openratelab.com${ogImage}`} />
<meta property="og:image:width" content={String(ogImageWidth)} />
<meta property="og:image:height" content={String(ogImageHeight)} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={`https://openratelab.com${ogImage}`} />

{jsonLd && jsonLd.map((block) => (
  <script type="application/ld+json" set:html={JSON.stringify(block)} />
))}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;600;700;800;900&family=JetBrains+Mono:wght@500&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
  rel="stylesheet"
/>
</head>
<body class="bg-surface-primary selection:bg-accent-performance selection:text-surface-primary">

{isHomepage ? (
  <nav class="fixed top-0 z-50 flex justify-between items-center w-full px-4 md:px-16 h-20 bg-surface-primary border-b border-muted-silver/20">
    <a href="#home" class="font-headline-md text-base md:text-headline-md font-bold tracking-tighter text-on-surface-warm uppercase hover:text-accent-performance transition-colors">OPENRATELAB</a>
    <div class="hidden md:flex items-center space-x-12">
      <a class="nav-link text-on-surface-warm font-label-button uppercase border-b-2 border-transparent hover:text-accent-performance transition-colors duration-150" href="#services" data-section="services">SERVICES</a>
      <a class="nav-link text-on-surface-warm font-label-button uppercase border-b-2 border-transparent hover:text-accent-performance transition-colors duration-150" href="#results" data-section="results">RESULTS</a>
      <a class="nav-link text-on-surface-warm font-label-button uppercase border-b-2 border-transparent hover:text-accent-performance transition-colors duration-150" href="#ledger" data-section="ledger">CASE STUDIES</a>
      <a class="text-on-surface-warm font-label-button uppercase border-b-2 border-transparent hover:text-accent-performance transition-colors duration-150" href="/about/">ABOUT</a>
      <a class="nav-link text-on-surface-warm font-label-button uppercase border-b-2 border-transparent hover:text-accent-performance transition-colors duration-150" href="#expertise" data-section="expertise">EXPERTISE</a>
      <a class="text-on-surface-warm font-label-button uppercase border-b-2 border-transparent hover:text-accent-performance transition-colors duration-150" href="/blog/">BLOG</a>
      <a class="nav-link text-on-surface-warm font-label-button uppercase border-b-2 border-transparent hover:text-accent-performance transition-colors duration-150" href="#contact" data-section="contact">CONTACT</a>
    </div>
    <div class="flex items-center gap-2">
      <a href="#contact" class="bg-on-surface-warm text-surface-primary px-3 py-2 md:px-6 md:py-3 font-label-button uppercase hover:bg-accent-performance hover:text-on-surface-warm transition-all duration-150 active:scale-95">BOOK AUDIT</a>
      <button class="md:hidden p-2" id="menu-toggle" aria-label="Open menu">
        <span class="material-symbols-outlined text-on-surface-warm" aria-hidden="true">menu</span>
      </button>
    </div>
  </nav>
) : (
  <nav class="fixed top-0 z-50 flex justify-between items-center w-full px-4 md:px-16 h-20 bg-surface-primary border-b border-muted-silver/20">
    <a href="/" class="font-headline-md text-base md:text-headline-md font-bold tracking-tighter text-on-surface-warm uppercase hover:text-accent-performance transition-colors">OPENRATELAB</a>
    <div class="hidden md:flex items-center space-x-12">
      <a class={navClass('services')} href="/#services">SERVICES</a>
      <a class={navLinkBase} href="/#results">RESULTS</a>
      <a class={navClass('case-studies')} href="/#ledger">CASE STUDIES</a>
      <a class={navClass('about')} href="/about/">ABOUT</a>
      <a class={navLinkBase} href="/#expertise">EXPERTISE</a>
      <a class={navClass('blog')} href="/blog/">BLOG</a>
      <a class={navClass('contact')} href="/#contact">CONTACT</a>
    </div>
    <div class="flex items-center gap-2">
      <a href="/#contact" class="bg-on-surface-warm text-surface-primary px-3 py-2 md:px-6 md:py-3 font-label-button uppercase hover:bg-accent-performance hover:text-on-surface-warm transition-all duration-150 active:scale-95">BOOK AUDIT</a>
      <button class="md:hidden p-2" id="menu-toggle" aria-label="Open menu">
        <span class="material-symbols-outlined text-on-surface-warm" aria-hidden="true">menu</span>
      </button>
    </div>
  </nav>
)}

<div class="fixed inset-0 bg-surface-primary z-[60] flex flex-col p-8 transform translate-x-full transition-transform duration-300 md:hidden" id="mobile-menu">
  <div class="flex justify-end mb-12">
    <button class="p-2" id="menu-close" aria-label="Close menu">
      <span class="material-symbols-outlined text-on-surface-warm" aria-hidden="true">close</span>
    </button>
  </div>
  <div class="flex flex-col gap-8">
    <a class="font-headline-lg-mobile text-headline-lg-mobile font-bold tracking-tighter text-on-surface-warm uppercase hover:text-accent-performance transition-colors" href={isHomepage ? '#services' : '/#services'}>SERVICES</a>
    <a class="font-headline-lg-mobile text-headline-lg-mobile font-bold tracking-tighter text-on-surface-warm uppercase hover:text-accent-performance transition-colors" href={isHomepage ? '#results' : '/#results'}>RESULTS</a>
    <a class="font-headline-lg-mobile text-headline-lg-mobile font-bold tracking-tighter text-on-surface-warm uppercase hover:text-accent-performance transition-colors" href={isHomepage ? '#ledger' : '/#ledger'}>CASE STUDIES</a>
    <a class="font-headline-lg-mobile text-headline-lg-mobile font-bold tracking-tighter text-on-surface-warm uppercase hover:text-accent-performance transition-colors" href="/about/">ABOUT</a>
    <a class="font-headline-lg-mobile text-headline-lg-mobile font-bold tracking-tighter text-on-surface-warm uppercase hover:text-accent-performance transition-colors" href={isHomepage ? '#expertise' : '/#expertise'}>EXPERTISE</a>
    <a class="font-headline-lg-mobile text-headline-lg-mobile font-bold tracking-tighter text-on-surface-warm uppercase hover:text-accent-performance transition-colors" href="/blog/">BLOG</a>
    <a class="font-headline-lg-mobile text-headline-lg-mobile font-bold tracking-tighter text-on-surface-warm uppercase hover:text-accent-performance transition-colors" href={isHomepage ? '#contact' : '/#contact'}>CONTACT</a>
  </div>
  <div class="mt-auto border-t border-muted-silver/20 pt-8">
    <a href={isHomepage ? '#contact' : '/#contact'} class="block text-center w-full bg-on-surface-warm text-surface-primary py-4 font-label-button uppercase tracking-widest active:scale-95 transition-transform">BOOK AUDIT</a>
  </div>
</div>

<main class="mt-20">
  <slot />
</main>

{isHomepage ? (
  <footer class="grid grid-cols-12 gap-gutter px-8 md:px-16 py-40 w-full bg-surface-primary border-t border-muted-silver/30">
    <div class="col-span-12 md:col-span-6 mb-20 md:mb-0">
      <div class="font-headline-lg text-2xl md:text-headline-lg font-black text-on-surface-warm uppercase tracking-tighter mb-8 leading-none">OPENRATELAB.</div>
      <p class="font-label-technical text-label-technical text-muted-silver max-w-md">PRECISION RETENTION SYSTEMS. ANALYTICALLY DRIVEN. EDITORIALLY EXECUTED. &copy;<span id="year">2026</span> OPENRATELAB.</p>
    </div>
    <div class="col-span-12 md:col-span-3">
      <span class="font-label-technical text-label-technical text-accent-performance mb-8 block uppercase">NAVIGATION</span>
      <ul class="space-y-4">
        <li><a class="font-label-button text-muted-silver uppercase hover:text-on-surface-warm underline transition-all" href="#services">SERVICES</a></li>
        <li><a class="font-label-button text-muted-silver uppercase hover:text-on-surface-warm underline transition-all" href="#results">RESULTS</a></li>
        <li><a class="font-label-button text-muted-silver uppercase hover:text-on-surface-warm underline transition-all" href="#ledger">CASE STUDIES</a></li>
        <li><a class="font-label-button text-muted-silver uppercase hover:text-on-surface-warm underline transition-all" href="#expertise">EXPERTISE</a></li>
        <li><a class="font-label-button text-muted-silver uppercase hover:text-on-surface-warm underline transition-all" href="/about/">ABOUT</a></li>
        <li><a class="font-label-button text-muted-silver uppercase hover:text-on-surface-warm underline transition-all" href="#testimonials">TESTIMONIALS</a></li>
        <li><a class="font-label-button text-muted-silver uppercase hover:text-on-surface-warm underline transition-all" href="#contact">CONTACT</a></li>
      </ul>
    </div>
    <div class="col-span-12 md:col-span-3">
      <span class="font-label-technical text-label-technical text-accent-performance mb-8 block uppercase">CONTACT</span>
      <ul class="space-y-4">
        <li><a class="font-label-button text-muted-silver uppercase hover:text-on-surface-warm underline transition-all" href="mailto:uros@openratelab.com">uros@openratelab.com</a></li>
        <li><a class="font-label-button text-muted-silver uppercase hover:text-on-surface-warm underline transition-all" href="#contact">BOOK FREE AUDIT</a></li>
      </ul>
    </div>
  </footer>
) : (
  <footer class="grid grid-cols-12 gap-gutter px-8 md:px-16 py-40 w-full bg-surface-primary border-t border-muted-silver/30">
    <div class="col-span-12 md:col-span-6 mb-20 md:mb-0">
      <div class="font-headline-lg text-2xl md:text-headline-lg font-black text-on-surface-warm uppercase tracking-tighter mb-8 leading-none">OPENRATELAB.</div>
      <p class="font-label-technical text-label-technical text-muted-silver max-w-md">PRECISION RETENTION SYSTEMS. ANALYTICALLY DRIVEN. EDITORIALLY EXECUTED. &copy;<span id="year">2026</span> OPENRATELAB.</p>
    </div>
    <div class="col-span-12 md:col-span-3">
      <span class="font-label-technical text-label-technical text-accent-performance mb-8 block uppercase">NAVIGATION</span>
      <ul class="space-y-4">
        <li><a class="font-label-button text-muted-silver uppercase hover:text-on-surface-warm underline transition-all" href="/#services">SERVICES</a></li>
        <li><a class="font-label-button text-muted-silver uppercase hover:text-on-surface-warm underline transition-all" href="/#ledger">CASE STUDIES</a></li>
        <li><a class="font-label-button text-muted-silver uppercase hover:text-on-surface-warm underline transition-all" href="/about/">ABOUT</a></li>
        <li><a class="font-label-button text-muted-silver uppercase hover:text-on-surface-warm underline transition-all" href="/blog/">BLOG</a></li>
        <li><a class="font-label-button text-muted-silver uppercase hover:text-on-surface-warm underline transition-all" href="/#contact">CONTACT</a></li>
      </ul>
    </div>
    <div class="col-span-12 md:col-span-3">
      <span class="font-label-technical text-label-technical text-accent-performance mb-8 block uppercase">CONTACT</span>
      <ul class="space-y-4">
        <li><a class="font-label-button text-muted-silver uppercase hover:text-on-surface-warm underline transition-all" href="mailto:uros@openratelab.com">uros@openratelab.com</a></li>
        <li><a class="font-label-button text-muted-silver uppercase hover:text-on-surface-warm underline transition-all" href="/#contact">BOOK FREE AUDIT</a></li>
      </ul>
    </div>
  </footer>
)}

<script>
  // Astro bundles page <script> tags as deferred ES modules, which run
  // after the document is already parsed — DOMContentLoaded has typically
  // already fired by then, so a listener for it here would never execute.
  // Running immediately is correct and safe: the DOM is guaranteed ready.
  const menuToggle = document.getElementById('menu-toggle');
  const menuClose = document.getElementById('menu-close');
  const mobileMenu = document.getElementById('mobile-menu');
  if (menuToggle && menuClose && mobileMenu) {
    menuToggle.addEventListener('click', () => mobileMenu.classList.remove('translate-x-full'));
    menuClose.addEventListener('click', () => mobileMenu.classList.add('translate-x-full'));
    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => mobileMenu.classList.add('translate-x-full'));
    });
  }
  const yearEl = document.getElementById('year');
  if (yearEl) yearEl.textContent = String(new Date().getFullYear());
</script>
</body>
</html>
